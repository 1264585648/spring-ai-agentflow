# ===================================================================
# 本地开发与测试联调配置模板 (复制一份为 application-local.yml 即可生效)
# 注意：application-local.yml 已被 .gitignore 忽略，绝不会提交至 GitHub
# ===================================================================
spring:
  datasource:
    url: jdbc:mysql://${MYSQL_HOST:localhost}:${MYSQL_PORT:3306}/${MYSQL_DB:enterprise_agent_db}?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
    username: ${MYSQL_USER:root}
    password: ${MYSQL_PASSWORD:your_password}

  ai:
    openai:
      base-url: ${OPENAI_BASE_URL:https://api.openai.com/v1}
      api-key: ${OPENAI_API_KEY:your_openai_or_deepseek_api_key}
      chat:
        options:
          model: ${OPENAI_MODEL:gpt-4o-mini}

apollo:
  meta: ${APOLLO_META:http://localhost:8080}
